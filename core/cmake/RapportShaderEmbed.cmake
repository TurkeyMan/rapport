# cmake -DIN=<compiled> -DOUT=<header> -DNAME=<name> -DLANGUAGE=<dxbc|spirv> -DENTRY=<entry> -P this:
# the compiled shader as a header, for rapport_add_shader.
file(READ ${IN} hex HEX)
string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){16})" "\\1\n    " bytes "${bytes}")
file(WRITE ${OUT} "// Generated by rapport_add_shader from ${IN}: don't edit.
#pragma once

#include \"rapport/gpu.h\"

#include <span>

namespace shaders
{

inline rap::gpu::shader ${NAME}()
{
    alignas(4) static const unsigned char code[] = {
    ${bytes}
    };
    rap::gpu::shader s;
    s.forms.push_back({rap::gpu::shader_language::${LANGUAGE}, std::as_bytes(std::span(code))});
    s.entry = \"${ENTRY}\";
    s.name = \"${NAME}\";
    return s;
}

}  // namespace shaders
")
